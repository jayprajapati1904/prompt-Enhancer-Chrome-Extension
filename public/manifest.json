{
  "manifest_version": 3,
  "name": "Universal AI Prompt Enhancer",
  "version": "4.1",
  "description": "Enhance prompts on any AI site with Tone Selection, Diff View, and Deep Detection. Built with React.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.bytez.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": ["*://*.google.com/search*", "*://*.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
